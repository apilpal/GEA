exports[`Custom Elements Snapshots StudentTable Snapshots renders table after filtering 1`] = `
"
      <div class="table-container">
        <div class="table-header">
          <h2>Total Students: <span id="total-count">1</span></h2>
          <div class="search-container">
            <input type="text" id="search-input" placeholder="Search students..." class="search-input">
            <button id="clear-search" style="display: none;">✕</button>
          </div>
          <button id="add-student-btn" class="add-student-btn">+ Add Student</button>
        </div>
        <table class="student-table">
          <thead>
            <tr>
              <th>Status</th>
              <th class="sortable-header" data-column="route">Route</th>
              <th class="sortable-header" data-column="name">Name</th>
              <th class="sortable-header" data-column="father_name">Father's Name</th>
              <th class="sortable-header" data-column="class">Class</th>
              <th class="sortable-header" data-column="mobile">Mobile</th>
              <th class="sortable-header" data-column="address">Address</th>
              <th class="sortable-header" data-column="fees">Fees</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="table-body">
      <tr class="student-row" data-index="0">
        <td>
          <span class="status-indicator active">
            Active
          </span>
        </td>
        <td>N/A</td>
        <td>John Doe</td>
        <td>N/A</td>
        <td>10A</td>
        <td>N/A</td>
        <td>N/A</td>
        <td>₹1000</td>
        <td class="actions-cell">
          <button class="action-btn view-btn" data-action="view" data-index="0" title="View Details">👁️</button>
          <button class="action-btn edit-btn" data-action="edit" data-index="0" title="Edit Student">✏️</button>
          <button class="action-btn delete-btn" data-action="delete" data-index="0" title="Delete Student">🗑️</button>
        </td>
      </tr>
    </tbody>
        </table>
      </div>
    "
`;

