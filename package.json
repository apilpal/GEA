{
  "name": "school-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Student Profiles PWA - run backend and frontend together",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/termux-setup.sh",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "create-admin": "cd backend && .venv/bin/python setup_local.py",
    "seed": "cd backend && .venv/bin/python seed_sample_data.py",
    "seed-school": "cd backend && .venv/bin/python seed_school_data.py",
    "backup": "cd backend && .venv/bin/python db_backup.py backup",
    "restore": "cd backend && .venv/bin/python db_backup.py restore",
    "reset-password": "cd backend && .venv/bin/python setup_local.py --reset-password"
  }
}
