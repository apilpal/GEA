{
  "name": "my-vscode-extension",
  "displayName": "My VSCode Extension",
  "description": "A basic TypeScript VSCode extension that provides commands",
  "version": "0.0.1",
  "publisher": "example-publisher",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:package.json",
    "onCommand:extension.mcpCodeSearch",
    "onCommand:extension.mcpDocSearch",
    "onCommand:extension.mcpRunTests",
    "onCommand:extension.openChat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.mcpCodeSearch",
        "title": "MCP: Code Search"
      },
      {
        "command": "extension.mcpDocSearch",
        "title": "MCP: Documentation Search"
      },
      {
        "command": "extension.mcpRunTests",
        "title": "MCP: Run Tests"
      },
      {
        "command": "extension.openChat",
        "title": "Open AI Chat Assistant"
      }
    ],
    "configuration": {
      "title": "My VSCode Extension",
      "properties": {
        "myVscodeExtension.mcpServerUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "URL for the MCP server"
        },
        "myVscodeExtension.backendApiUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL for the backend API"
        },
        "myVscodeExtension.enableDebugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode for additional logging"
        },
        "myVscodeExtension.maxSearchResults": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of search results to return"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.0.0",
    "eslint": "^8.34.0",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5"
  }
}